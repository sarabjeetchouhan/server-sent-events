        <mxCell id="title" parent="1" vertex="1" value="Order management: web client and backend" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#ffffff;fontColor=#172033;fontSize=26;fontFamily=Arial;">
